raw `
MintakaCity_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, MintakaCity_HideAcolyteActors
	.byte 0

MintakaCity_HideAcolyteActors:
	setflag FLAG_HIDE_MINTAKA_ACOLYTE
	setflag FLAG_HIDE_MINTAKA_CARGO_WORKER
	end
`

