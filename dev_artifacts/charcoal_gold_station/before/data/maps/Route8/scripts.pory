    "There's a Pokémon blocking the bridge.\p"
    "If you need to get to Castula City,\n"
    "you'll have to go through\l"
    "Dreamcatcher Woods."
}

text Route8_Text_PokemonBarrier {
    "The Pokémon is projecting some kind\n"
    "of barrier."
}
