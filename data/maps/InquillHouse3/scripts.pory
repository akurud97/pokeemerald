text InquillHouse3_Text_Object1 {
    "Oh dear, are you out on your own?\n"
    "Feel free to stay for dinner."
}

text InquillHouse3_Text_Object2 {
    "I’m supposed to be eating my dinner,\n"
    "but I’m so close to beating this game!"
}
