raw `
TrainerSchool_MapScripts::
	.byte 0
`
script TrainerSchool_EventScript_Starter1{

    lockall
    showmonpic(SPECIES_TOTODILE, 10,3)
    msgbox("Do you want to choose Totodile?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        givemon(SPECIES_TOTODILE, 5, ITEM_POKE_BALL)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Received Totodile!")
            removeobject(1)
            setflag(VAR_UNUSED_0x40F7)
            call(NicknamePartyMon)
        }
        else{
            hidemonpic
            msgbox(TrainerSchool_NotChosen)
        }
    }
        waitmessage
        releaseall
        end
}
