text InquillHouse4_Text_Object1 {
    "Here kitty kitty! Here kitty!\n"
    "Who’s a good boy!"
}

text InquillHouse4_Text_Object2 {
    "When we took our Persians to the\n"
    "Pokémon breeders outside town, we\l"
    "never expected a litter this big…"
}

text InquillHouse4_Text_Object3 {
    "The Persian is eyeing you carefully."
}

text InquillHouse4_Text_Object4 {
    "Me-owth!"
}

text InquillHouse4_Text_Object5 {
    "Meow-meow-meowth."
}

text InquillHouse4_Text_Object6 {
    "Purrrrsian."
}

text InquillHouse4_Text_Object7 {
    "Meoowrr!"
}

text InquillHouse4_Text_Object8 {
    "This Meowth looks very contented."
}
