raw `
InquillMart_MapScripts::
	.byte 0

InquillMart_EventScript_Clerk::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	pokemart InquillMart_Pokemart
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

	.align 2
InquillMart_Pokemart:
	.2byte ITEM_POKE_BALL
	.2byte ITEM_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_REPEL
	.2byte ITEM_NONE
	release
	end
`

script InquillMart_EventScript_Object2 {
    msgbox(InquillMart_Text_Object2, MSGBOX_NPC)
    end
}

text InquillMart_Text_Object2 {
    "Inquill might be a quiet town, but to\n"
    "me it’s the big city. So much variety…"
}
