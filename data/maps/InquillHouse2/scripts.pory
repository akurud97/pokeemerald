text InquillHouse2_Text_Object1 {
    "The new hydrology lab is going to\n"
    "bring a lot of jobs to town. But it\l"
    "will bring a lot of change too."
}

text InquillHouse2_Text_Object2 {
    "The house is going to be so quiet\n"
    "when our daughter is gone…"
}

text InquillHouse2_Text_Object3 {
    "I’m going to university this fall.\n"
    "I’m so excited to be in the big city!"
}
