raw `
MintakaMart_MapScripts::
	.byte 0

MintakaMart_EventScript_Clerk::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	pokemart MintakaMart_Pokemart
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

	.align 2
MintakaMart_Pokemart:
	.2byte ITEM_POKE_BALL
	.2byte ITEM_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_REPEL
	.2byte ITEM_NONE
	release
	end
`

script MintakaMart_EventScript_Object2 {
    lock
    msgbox(MintakaMart_Text_Object2, MSGBOX_DEFAULT)
    release
    end
}

script MintakaMart_EventScript_Object3 {
    msgbox(MintakaMart_Text_Object3, MSGBOX_NPC)
    end
}

text MintakaMart_Text_Object2 {
    "Hmm… I wonder if these would heal a\n"
    "person’s injuries too…"
}

text MintakaMart_Text_Object3 {
    "There’s some really good deals in here."
}
